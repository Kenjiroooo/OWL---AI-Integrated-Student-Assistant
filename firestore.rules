rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedStudent() {
      return isSignedIn() && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'student';
    }

    function isAdmin() {
      return isSignedIn() && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Entity Validations ---
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'role', 'fullName']) &&
             data.uid == request.auth.uid &&
             data.role in ['student', 'admin'] &&
             data.email is string && data.fullName is string &&
             data.fullName.size() <= 100;
    }

    function isValidFeedback(data) {
      return data.keys().hasAll(['category', 'content', 'createdAt']) &&
             data.category is string && data.content is string &&
             data.content.size() <= 1000 &&
             data.createdAt == request.time;
    }

    function isValidQueueTicket(data) {
      return data.keys().hasAll(['ticketNumber', 'studentId', 'serviceType', 'status', 'createdAt']) &&
             data.status in ['waiting', 'serving', 'completed', 'cancelled'] &&
             data.createdAt == request.time;
    }

    function isValidDocRequest(data) {
      return data.keys().hasAll(['studentId', 'documentType', 'status', 'createdAt']) &&
             data.status in ['pending', 'processing', 'ready', 'claimed'] &&
             data.createdAt == request.time;
    }

    function isValidFacultyEvaluation(data) {
      return data.keys().hasAll([
               'studentNumber', 'subjectCode', 'evaluationSchool',
               'facultyId', 'facultyName', 'periodId',
               'ratings', 'overallAverage', 'createdAt'
             ]) &&
             data.keys().hasOnly([
               'studentNumber', 'subjectCode', 'evaluationSchool',
               'facultyId', 'facultyName', 'schoolId', 'schoolName',
               'periodId', 'ratings', 'overallAverage', 'comment', 'createdAt'
             ]) &&
             data.studentNumber is string &&
             data.studentNumber.matches('^\\d{2}-\\d{4}-\\d{3}$') &&
             data.subjectCode is string &&
             data.subjectCode.matches('^[A-Z]{2,5}\\d{2,4}$') &&
             data.evaluationSchool is string && data.evaluationSchool.size() <= 120 &&
             data.facultyId is string && data.facultyId.size() <= 100 &&
             data.facultyName is string && data.facultyName.size() <= 150 &&
             data.periodId is string && data.periodId.size() >= 1 && data.periodId.size() <= 64 &&
             data.ratings is map &&
             data.overallAverage is number &&
             data.overallAverage >= 1 && data.overallAverage <= 5 &&
             (!('comment' in data) || (data.comment is string && data.comment.size() <= 2000)) &&
             data.createdAt is timestamp;
    }

    // --- Collection Matches ---

    // Users
    match /users/{userId} {
      allow get: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isSignedIn() && isOwner(userId) && isValidUser(incoming());
      allow update: if isSignedIn() && isOwner(userId) && 
                      incoming().diff(existing()).affectedKeys().hasOnly(['fullName', 'yearLevel', 'program', 'enrollmentStatus', 'balance']) &&
                      isValidUser(incoming());
    }

    // Announcement (Public Read, Admin Write)
    match /announcement/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Queue Tickets
    match /queueTickets/{id} {
      allow list: if isAdmin() || (isSignedIn() && resource.data.studentId == request.auth.uid);
      allow get: if isSignedIn() && (isAdmin() || resource.data.studentId == request.auth.uid);
      allow create: if isSignedIn() && isValidQueueTicket(incoming());
      allow update: if isAdmin() || (isSignedIn() && existing().studentId == request.auth.uid && incoming().status == 'cancelled');
    }

    // Lost and Found
    match /lostAndFound/{id} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if isAdmin() || (
                      isSignedIn() &&
                      incoming().diff(existing()).affectedKeys().hasOnly(['status', 'claimId', 'releasedAt']) &&
                      incoming().status in ['active', 'claim_pending', 'released', 'claimed']
                    );
      allow delete: if isAdmin();
    }

    // Lost and Found Claims
    match /lostAndFoundClaims/{id} {
      allow create: if isSignedIn() &&
                       incoming().keys().hasAll(['itemId', 'itemName', 'claimantName', 'studentId', 'contactNumber', 'status', 'claimedAt']) &&
                       incoming().status == 'pending' &&
                       incoming().claimantName is string && incoming().claimantName.size() <= 150 &&
                       incoming().studentId is string && incoming().studentId.size() <= 50 &&
                       incoming().contactNumber is string && incoming().contactNumber.size() <= 50;
      allow read: if isSignedIn();
      allow update: if isAdmin() || (
                      isSignedIn() &&
                      incoming().diff(existing()).affectedKeys().hasOnly(['status', 'releasedAt', 'rejectedAt']) &&
                      incoming().status in ['released', 'rejected']
                    );
      allow delete: if isAdmin();
    }

    // Kiosk <-> Phone photo hand-off for Lost & Found (short-lived sessions).
    // No auth required: the unguessable UUID is the secret, so listing is disabled.
    match /kioskUploads/{sessionId} {
      allow get: if isValidId(sessionId);
      allow list: if false;

      // Kiosk opens a session
      allow create: if isValidId(sessionId) &&
                       incoming().keys().hasOnly(['status', 'createdAt']) &&
                       incoming().status == 'waiting' &&
                       incoming().createdAt == request.time;

      // Phone fills it once, within 10 minutes of creation
      allow update: if existing().status == 'waiting' &&
                       request.time < existing().createdAt + duration.value(10, 'm') &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['status', 'image', 'uploadedAt']) &&
                       incoming().status == 'uploaded' &&
                       incoming().image is string &&
                       incoming().image.size() < 900000 &&
                       incoming().image.matches('data:image/(jpeg|png|webp);base64,.*');

      // Kiosk cleans up after receiving (or on cancel/expiry)
      allow delete: if isValidId(sessionId);
    }

    // Feedback
    match /feedback/{id} {
      allow create: if isSignedIn() && isValidFeedback(incoming());
      // Allow the original submitter's auth session to patch AI evaluation fields only
      allow update: if isSignedIn() &&
                       existing().studentId == request.auth.uid &&
                       incoming().diff(existing()).affectedKeys()
                         .hasOnly(['sentiment', 'urgency', 'summary', 'tags', 'actionability', 'evaluatedAt']);
      allow read: if isAdmin();
    }

    // Campus Data (Public Read)
    match /campusBuildings/{id} { allow read: if true; allow write: if isAdmin(); }
    match /facultyOffices/{id} { allow read: if true; allow write: if isAdmin(); }
    match /ejeepSchedule/{id} { allow read: if true; allow write: if isAdmin(); }
    match /inquiryBase/{id} { allow read: if true; allow write: if isAdmin(); }

    // Payment Transactions
    match /paymentTransactions/{id} {
      allow list: if isAdmin() || (isSignedIn() && resource.data.studentId == request.auth.uid);
      allow get: if isSignedIn() && (isAdmin() || resource.data.studentId == request.auth.uid);
      allow create: if isAdmin(); // Only system/admin initiates real tx
    }

    // Document Requests
    match /docRequests/{id} {
      allow list: if isAdmin() || (isSignedIn() && resource.data.studentId == request.auth.uid);
      allow get: if isSignedIn() && (isAdmin() || resource.data.studentId == request.auth.uid);
      allow create: if isSignedIn() && isValidDocRequest(incoming());
      allow update: if isAdmin();
    }

    // Faculty Evaluations (authenticated kiosk sessions read/submit validated evaluations)
    match /facultyEvaluations/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidFacultyEvaluation(incoming());
      allow update, delete: if isAdmin();
    }

    // Settings (evaluationPeriod readable by kiosk; admin writes only)
    match /settings/{settingId} {
      allow read: if isSignedIn() || settingId == 'evaluationPeriod';
      allow write: if isAdmin();
    }

    // Exam Schedules
    match /examSchedules/{id} {
      allow list: if isAdmin() || (isSignedIn() && resource.data.studentId == request.auth.uid);
      allow get: if isSignedIn() && (isAdmin() || resource.data.studentId == request.auth.uid);
      allow write: if isAdmin();
    }
  }
}
