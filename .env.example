
# ─────────────────────────────────────────────────────────────────────────────
# OWL Kiosk System — Environment Variables Template
# Copy this file to .env and fill in your actual values.
# ⚠ NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# DeepSeek AI API Key (required for OWL chatbot)
# Get your key at: https://platform.deepseek.com/
DEEPSEEK_API_KEY="your-deepseek-api-key-here"

# ImgBB API Key (required for Lost & Found image uploads)
# Get your key at: https://api.imgbb.com/
IMGBB_API_KEY="your-imgbb-api-key-here"

# Gemini API Key (required for Lost & Found image moderation)
# Get your key at: https://aistudio.google.com/apikey
GEMINI_API_KEY="your-gemini-api-key-here"

# Firebase Configuration
# Get these values from: Firebase Console → Project Settings → General → Your apps
FIREBASE_API_KEY="your-firebase-api-key"
FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
FIREBASE_DATABASE_URL="https://your-project-default-rtdb.firebasedatabase.app"
FIREBASE_PROJECT_ID="your-project-id"
FIREBASE_STORAGE_BUCKET="your-project.firebasestorage.app"
FIREBASE_MESSAGING_SENDER_ID="000000000000"
FIREBASE_APP_ID="1:000000000000:web:0000000000000000"
FIREBASE_MEASUREMENT_ID="G-XXXXXXXXXX"

# App URL (auto-injected in production, localhost for development)
APP_URL="http://localhost:3000"

# Public URL phones should open when scanning the Lost & Found "Upload from Phone" QR code.
# Use your deployed address (no trailing slash). Leave empty to use the current site origin.
PUBLIC_APP_URL="https://app.your-subdomain.workers.dev"
