# Security headers for static files served by the Cloudflare Worker assets layer.
# (API responses get their own headers inside worker/index.ts.)
# No CSP / Permissions-Policy on purpose: the kiosk uses Firebase, map tiles,
# the microphone (speech) and a local Piper TTS server, which a strict policy would break.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
/index.html
  Cache-Control: no-cache
/assets/*
  Cache-Control: public, max-age=31536000, immutable
